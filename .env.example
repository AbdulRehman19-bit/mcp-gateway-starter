# Copy to .env and fill in. NEVER commit .env.

# --- Gateway ---
GATEWAY_TRANSPORT=stdio            # stdio | http
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
GATEWAY_POLICY_PATH=policies/policy.example.yaml
GATEWAY_READ_ONLY=true             # global kill switch: forces read-only for every role
GATEWAY_LOG_LEVEL=INFO

# --- Target database (what the AI can touch) ---
# Read-only role: SELECT grants only
TARGET_DB_RO_URL=postgresql+asyncpg://gateway_ro:change-me-ro@localhost:5432/demo
# Read-write role: used only for approved/allowed writes
TARGET_DB_RW_URL=postgresql+asyncpg://gateway_rw:change-me-rw@localhost:5432/demo

# --- Gateway's own database (audit log, approvals) ---
GATEWAY_DB_URL=postgresql+asyncpg://gateway_app:change-me-app@localhost:5432/gateway

# --- OAuth / OIDC (resource server) ---
OAUTH_ISSUER=http://localhost:8080/realms/mcp-gateway
OAUTH_AUDIENCE=mcp-gateway
OAUTH_JWKS_URL=http://localhost:8080/realms/mcp-gateway/protocol/openid-connect/certs

# --- Approvals ---
APPROVAL_TTL_MINUTES=30
